#!/bin/sh
# ============================================================
# Commit-msg hook MyKTAMap community
# ============================================================
# Le pre-commit ne voit pas le message ; ce hook voit le message ET l'index : seul endroit où une
# dérogation peut être exigée dans le message, donc archivée dans l'historique Git.
# Activer (comme le pre-commit) : git config core.hooksPath .githooks
# ⚠️ `git commit --no-verify` désarme AUSSI l'anti-fuite pro.
# ============================================================

if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  [commit-msg] Node.js introuvable — check release/docs skippé."
  exit 0
fi

# Aucun fichier data/ indexé : relevés réels, et data/index.json est suivi (un `commit -a` suffit).
# Dérogation : ligne `Data-deroge:`. BLOQUANT.
node scripts/check-data-hors-git.js "$1" || exit $?

# Un bump de version.json : 3 sources de version concordantes (jamais dérogeable) et docs des 4 axes
# à jour (dérogeable par `Docs-deroge:`). Un commit sans bump passe en silence. BLOQUANT.
node scripts/check-release-docs.js "$1" || exit $?

# Le message de commit est public : aucun nom réel lié aux relevés. BLOQUANT.
node scripts/check-noms-reels.js --message "$1" || exit $?
