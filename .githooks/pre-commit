#!/bin/sh
# ============================================================
# 🛡️ Pre-commit hook MyKTAMap community
# ============================================================
# Bloque tout commit qui contiendrait du code appartenant au
# repo MyKTAMap-pro (privé). Voir scripts/check-no-pro-leak.js
# pour la liste des patterns / fichiers interdits.
#
# Pour activer ce hook :
#   git config core.hooksPath .githooks
#
# Pour bypass en urgence :
#   git commit --no-verify
# ============================================================

# Vérifie que Node.js est disponible (cross-platform)
if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  [pre-commit] Node.js introuvable — check anti-fuite pro skippé."
  echo "    Installer Node depuis https://nodejs.org pour activer le hook."
  exit 0
fi

# Lance les checkers
node scripts/check-no-pro-leak.js || exit $?

# 🆕 v1.44.0 — Advisory linter ModalLifecycle (avertit mais ne bloque pas)
node scripts/check-modal-lifecycle.js

# 🆕 v1.74.0 — Surface d'API : CHARGE les modules IIFE et vérifie que chaque
# méthode annoncée existe. `node -c` ne valide QUE la syntaxe : un identifiant
# supprimé mais encore référencé dans un bloc d'exports passe le check et
# casse au chargement navigateur (ReferenceError vécu le 01/08 sur
# WALLPAPER_MAX_PX — le même patch raté avait aussi fait sauter
# setWallpaperCadrage des exports, sans aucun signal).
# BLOQUANT : contrairement au linter ModalLifecycle, ici un échec = module
# mort au boot, jamais un faux positif.
node scripts/check-api-surface.js || exit $?

# 🆕 v1.75.0 — Prefs globales : APP_CONFIG est RECONSTRUIT a chaque chargement
# de plan. Une pref sauvegardee mais absente de la liste de relecture retombe
# silencieusement sur son defaut (bug vecu le 03/08 : le magnetisme au dessin
# repassait a OFF des l'ouverture d'un plan). BLOQUANT.
node scripts/check-prefs-survival.js || exit $?

# 🎨 v1.75.2 — Table canonique des styles : tant que des tables subsistent
# (migration en cours), on verifie qu'elles ne DERIVENT pas de la reference.
# Un oubli y est invisible : exporter.js avait perdu `inaccessible` et une zone
# dangereuse sortait en gris remblais dans l'export PNG. BLOQUANT.
node scripts/check-style-canon.js || exit $?
node scripts/check-style-resolver.js || exit $?

# 🌍 v1.76.0 — Sortie KML : le KMZ a ses PROPRES largeurs (unite different du
# `weight` Leaflet, ajustee a l'echelle GPS) et ses propres alphas. Brancher
# naivement le resolveur dessus changerait le rendu dans Google Earth sans que
# personne le voie. Ce script fige les 14 styles built-in et verifie que les
# types custom recoivent bien un <Style> (bug 2 : styleUrl pendant = couleur
# perdue). BLOQUANT.
node scripts/check-kml-styles.js || exit $?

# 🔁 v1.76.0 — Round-trip de la legende : type custom -> calque de donnees ->
# plan regenere. Avant, seul l'ID du type voyageait et les objets ressortaient
# blancs/gris, sans aucune ligne de legende ni moyen de reparer. Verrouille
# aussi l'idempotence du re-import et la regle de conflit (le plan gagne).
# BLOQUANT.
node scripts/check-legend-roundtrip.js || exit $?

# 🧭 v1.76.1 — Math de l'estimation du point B de georef (A + echelle + Nord).
# Fonction extraite du code REEL de config.js ; a attrape Number(null)=0 des
# son premier run (un A a lat nulle serait parti a l'equateur). BLOQUANT.
node scripts/check-georef-estimation.js || exit $?

# 🖼️ v1.76.1 — Parseur binaire de dimensions d'images du Generateur (bug JPG
# 32Kx32K « non decodable » : Chrome/Skia refuse un cote > 32767 px, on lit
# l'en-tete sans decoder). Fixtures synthetiques PNG/GIF/WebP/JPEG. BLOQUANT.
node scripts/check-image-header-dims.js || exit $?

# 🔁 v1.76.2 — Convertisseur de resolution de l'editeur de donnees (migration
# des donnees d'une carriere entre deux scans). Le champ coordonnee OUBLIE est
# le bug classique : chaque tableau du format est eprouve + aller-retour. BLOQUANT.
node scripts/check-resolution-convert.js || exit $?

# 🛠️ v1.76.3 — Manifest de la bibliotheque de docs du Mode Developpeur :
# chaque chemin liste existe, chaque .md d'architecture est liste, hash mdp
# au format SHA-256. BLOQUANT.
node scripts/check-devmode-docs.js || exit $?

# 🗼 v1.76.4 — Geometrie du superoverlay KMZ (tuiles V2 -> GroundOverlays
# Region/Lod) : pavage exact, jointures, bords bornes a l'emprise, coherence
# inter-niveaux, Lod/drawOrder, non-regression image unique. BLOQUANT.
node scripts/check-kmz-superoverlay.js || exit $?

# ❓ Structure de l'Aide integree. Elle vit en HTML DUR dans deux
# fonctions jumelles (_aideHtmlFr / _aideHtmlEn) rangees par des INDEX
# NUMERIQUES communs aux 2 langues. Trois bugs le 01/09 : un conteneur oublie
# fusionnait 2 sections FR (« Mode profil » inatteignable), la meme section
# n'existait pas en EN (index communs pointant sur des sujets differents), et
# un index annonce a 29 pour une section en 30 laissait « Mon carnet » dans le
# filet « Autres ». Verifie : meme nombre de sections FR/EN, 1 titre par
# section, couverture complete, pas de doublon ni de hors-bornes. BLOQUANT.
node scripts/check-aide-sections.js || exit $?

# 📄 Transport des PDF du Mode Histoire dans l'export de profil (dette D1).
# Le carnet voyageait depuis v1.74.0, pas ses documents : un profil reimporte
# arrivait avec les notes libres et des PDF absents, sans un mot. Verifie :
# opt-in STRICT (un plan peut porter 100 Mo), les 5 points de branchement UI,
# aucune 3e copie du schema IDB (deja duplique modeHistoire/journalUi), et
# l'idempotence du reimport (put, pas add). BLOQUANT.
node scripts/check-profile-histpdf.js || exit $?

# 🏷️ Catalogue des tags built-in : UNE seule source (dette : icones portail
# absentes en Vue OSM, v1.81.0). `js/osmHomePreview.js` gardait une COPIE de
# `js/map.js > TAGS_BUILTIN` parce que la globale n'existait qu'apres le
# chargement d'un plan, alors que le HOME s'affiche AVANT. La copie a derive
# deux fois en silence (`entree_plan` v1.41.0, `portail` v1.59.0) : un point
# portail tombait sur le circleMarker de secours, petit rond jaune au lieu de
# son icone. Verifie la parite des deux tables DANS LES DEUX SENS, que le HOME
# lit bien la globale, et qu'elle est exposee au TOP-LEVEL. BLOQUANT.
node scripts/check-icon-catalog.js || exit $?

# 📐 Projection Lambert 93 (EPSG:2154) de l'import SIG. QGIS exporte
# massivement en L93 en France : l'app le convertit au lieu de le refuser.
# Le controle ne compare a AUCUNE table de reference (une table recopiee est
# elle-meme une source d'erreur) : il verifie les PROPRIETES DEFINITOIRES de
# la projection - origine exacte sur (700000, 6600000), echelle 1 sur les deux
# paralleles standard, conformite, aller-retour - plus la surete de la
# detection (ne jamais confondre des degres avec des metres, ne jamais
# reprojeter un fichier mixte a moitie). BLOQUANT.
node scripts/check-lambert93.js || exit $?

# 🔤 Constantes MAJUSCULES utilisees mais jamais declarees. Ne des le 03/09 :
# le nettoyage de code mort du 09/08 avait supprime `const HEADER_HEIGHT_MM`
# de pdfExport.js alors qu elle etait utilisee 20 lignes plus bas - toute
# generation de PDF avec en-tete echouait depuis, sans que rien ne le voie
# (node -c ne resout pas les identifiants, et le smoke ne genere pas de PDF).
# C est le linter minimal que ce projet n a pas, sur le seul motif qui a
# reellement mordu. BLOQUANT.
node scripts/check-constantes-orphelines.js || exit $?

# 🗺️ Listener pose sur la map Leaflet dont la garde anti-doublon vit ailleurs
# que sur la map. `window.map` est REMPLACEE a chaque plan charge : un drapeau
# global survit au remplacement, annonce « deja branche » et le listener ne se
# pose plus jamais. Le piege a mordu deux fois - v1.30.0 (culling des markers,
# corrige en portant le drapeau sur la map) puis v1.82.0 (largeur des fronts au
# zoom), la lecon de la premiere fois etant pourtant ecrite dans le depot.
# Symptome qui egare : le contournement de l utilisateur marche, parce qu un
# re-rendu rappelle la fonction. Le mecanisme a l air vivant, seul son
# declencheur a disparu. BLOQUANT.
node scripts/check-map-listeners.js || exit $?

# 👣 Reglage de podometre recopie en dur avec une valeur qui diverge de
# l'usine (js/config.js > DEFAULT_CONFIG). Ne le 03/09 : trois generateurs
# (SIG, GPX, KMZ) ecrivaient `stepThreshold: 1.2` la ou l'usine dit 13. Or
# tracking.js compare ce seuil a la magnitude de accelerationIncludingGravity,
# qui vaut DEJA ~9,81 telephone pose : la condition etait vraie en permanence
# et fabriquait ~3,6 pas/seconde A L'ARRET, soit pres de 10 km/h de distance
# fantome sur tout plan issu d'un import. BLOQUANT.
node scripts/check-tracking-defaults.js || exit $?

# 🏷️ Ajout de plans PAR ETIQUETTE dans la pile multi-plans de la Vue OSM du
# HOME. Deux regles y regressent en silence : le regroupement INSENSIBLE A LA
# CASSE (« Gironde » et « GIRONDE » doivent faire UNE etiquette — sinon deux
# chips montrent chacun la moitie de leurs plans, et le bug ne se voit que si
# on a justement tape les deux orthographes), et l ASYMETRIE du clic (ajouter
# seulement les manquants, retirer seulement quand ils y sont tous). BLOQUANT.
node scripts/check-osm-etiquettes.js || exit $?

# 🔄 Rapatriement d un calque de donnees dans la session. Deux pieges y sont
# mortels et silencieux : un VERROU POSE SANS SA COPIE masque le calque et
# donne un plan vide sans un mot (cas reel : la sauvegarde saute sur quota,
# 1,1 Mo etant exactement le seuil sur un releve SIG), et un EFFACEMENT DE
# SESSION qui laisserait le verrou ferait disparaitre le releve de l auteur.
# Verifie aussi que la copie est defensive (muter le calque source serait une
# corruption definitive) et que le retour ne retire QUE ce qui est marque. BLOQUANT.
node scripts/check-calque-session.js || exit $?

# 🧰 Les DEUX outils de lecture de la carte en Vue OSM (📏 mesure et 📍
# coordonnees de surface) et la regle qui les lie. Trois choses y regressent
# sans bruit : l ASYMETRIE entre les deux vues (la mesure a vecu deux versions
# dans le HOME et pas dans le mode plan, sans raison technique), l EXCLUSION
# MUTUELLE (les deux arment le meme evenement `click` : coexistants, chaque
# releve de coordonnee pose aussi un point de mesure), et le DEMONTAGE (un
# listener laisse sur la map continue d agir apres fermeture). BLOQUANT.
node scripts/check-osm-outils.js || exit $?

# 📌 Le repositionnement d un POI de session (« si le POI a ete mal mis »).
# Premier picker « clic carte » qui MUTE un objet de la session au lieu de
# remplir un champ : quatre choses y regressent sans bruit. La CONVERSION
# INVERSE de convertCoord (inverser lat/lng deplace le point ailleurs que sous
# le doigt, et ca a l air volontaire). L INDEX PERIME (entre l armement et le
# clic la session a pu changer : un index fige deplacerait le mauvais point).
# La MUTATION EN PLACE (reconstruire le point lui ferait perdre `_srcCalque`
# — donc un doublon a la restauration du calque — et son `level`, donc un
# etage change en douce). Et les LIAISONS INTER-PLAN, qui stockent les coords
# servant au trace du lien a l export KMZ : sans recalage le lien part de
# l ancienne position. Les 7 sabotages de reference rougissent. BLOQUANT.
node scripts/check-repositionner.js || exit $?

# 🧭 Le tableau recapitulatif des groupes de la barre laterale (3 langues)
# confronte a ce que interface.js declare vraiment. Rien ne faisait ce
# rapprochement, d ou une doc qui a decrit pendant des MOIS une interface
# disparue : un bouton 🗑️ voisin de ✏️ retire le 25/05 (b9de2fa), et surtout
# « 🏗️ Creer / Modifier plan » presente comme un groupe de la barre alors
# qu il en a ete RETIRE a la refonte v1.14.19, code supprime en v1.26.2 —
# l utilisateur pouvait chercher ce bouton indefiniment. Plus « 11 groupes »
# annonces pour 13 declares, trois groupes reels absents du tableau, et une
# note inseree AU MILIEU qui le coupait en deux au rendu Markdown. Les 5
# defauts reels rougissent. BLOQUANT.
node scripts/check-doc-sidebar.js || exit $?

# 🎯 La selection multiple et la conversion EN LOT. Six choses y regressent
# sans bruit. La REGLE DE COMPATIBILITE porte sur l OUVERTURE (ligne vs
# surface fermee), PAS sur la famille : un trace et un front de taille sont
# tous deux des lignes, et les melanger est LE cas utile — 40 fronts mal
# types qui deviennent des galeries. La resserrer sur la famille tuerait la
# raison d etre de la feature sans casser un test naif. Le REFUS doit etre
# EXPLIQUE (un clic sans effet et sans mot se lit comme un bug). Le LOT doit
# etre UN geste : un instantane, une entree d historique, une ecriture par
# famille TOUCHEE — sinon annuler demanderait N Ctrl+Z et on paierait N
# re-rendus complets. Les trois listes sont lues AVANT toute ecriture. Une
# cible DEJA atteinte est sautee, pas comptee en echec. Et `itinerary` reste
# hors selection. Les 8 sabotages de reference rougissent. BLOQUANT.
node scripts/check-selection-multi.js || exit $?

# 🔁 La REPRISE d une sortie interrompue et la FUSION manuelle. Cinq choses y
# regressent sans bruit. Le SIGNAL de reprise n est pas un delai mais
# `closedBy: crash` — pose uniquement quand l app a ete tuee SOUS
# l utilisateur : reprendre sur le delai seul recollerait une sortie qu il a
# cloturee expres. La BASELINE est RECONSTRUITE par soustraction de ce qui est
# deja en banque — une baseline neuve remettrait tous les compteurs a zero et
# la reprise n aurait l air de marcher que de loin. La GARDE D ID protege la
# substitution asynchrone (sans elle, soit la reprise n arrive jamais, soit
# elle ecrase une sortie deja repartie). A la fusion, `wallMs` est debut->fin
# TROUS COMPRIS, jamais une somme, et le resultat est ECRIT avant que les
# autres soient supprimees. Enfin `WakeLock.init()` doit rester appele au boot
# — il ne l etait NULLE PART, d ou l option ecran-allume morte en PWA iOS.
# Les 7 sabotages de reference rougissent. BLOQUANT.
node scripts/check-journal-reprise.js || exit $?

# 🔆 L option « garder l ecran allume », et le VERROU FANTOME qui a resiste a
# deux diagnostics. Au demarrage, sans geste utilisateur, iOS ACCEPTE la
# demande — `request()` resout, on tient un sentinel, `isActive()` rend vrai —
# puis il l IGNORE : ni erreur, ni evenement `release`. Et le fantome se
# verrouille lui-meme, `_acquire()` sortant des qu un sentinel est en main :
# aucune reprise n etait possible. Decocher/recocher reparait parce que c est
# un relachement puis une acquisition SOUS GESTE — le module refait donc ce
# geste seul au premier contact. Couvre aussi le defaut OFF de la vibration
# haptique et l absence de tout `!== false` (qui rend VRAI sur undefined et
# rallumerait l option). BLOQUANT.
node scripts/check-wakelock.js || exit $?

# ⚖️ LA PORTEE DES REGLAGES (audit KARMA du 07/09). La config du MODE PLAN ne
# doit concerner QUE le plan : un reglage qui, modifie la, affecte toute
# l application n y a rien a faire. Dix y vivaient — cocher « magnetisme au
# dessin » depuis un releve le cochait pour TOUS, sans un mot. Le pire cas
# avait deja ete paye en v1.59.0 sur les toggles Perf ULTRA.
# On tranche sur la PERSISTANCE, jamais sur l onglet : est global ce que
# `sauvegarderPrefsUtilisateur()` ecrit dans `app_user_prefs`. Deux tolerances
# EXPLICITES (vibration, batterie) : on les ajuste en cavite, remonter au HOME
# pour couper la vibration serait absurde. Verifie aussi que les rapatries sont
# ATTEIGNABLES au HOME — les sortir sans les y mettre serait pire —, que la nav
# intelligente est passee par plan AVEC son repli de migration, et que les
# toggles Perf ne sont plus affiches au HOME ou ils ne persistaient rien.
node scripts/check-portee-reglages.js || exit $?
