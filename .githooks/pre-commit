#!/bin/sh
# ============================================================
# Pre-commit hook MyKTAMap community
# ============================================================
# Une ligne par garde-fou : ce qu'il protege. Le detail (pourquoi, sabotages) vit dans l'en-tete du script.
# Rejoue tel quel en CI (.github/workflows/ci.yml) ; scripts/garde-fous-tableau.js lit les lignes `node scripts/`.
# BLOQUANT = `|| exit $?` ; sans, consultatif. En CI rien n'est indexe : un script qui lit l'index
# (git diff --cached) doit aussi etre appele par scripts/ci-commits.sh (KTA_FICHIERS_CI) ou relire tout le
# depot sous CI, sinon il passe a vide.
# Activer : git config core.hooksPath .githooks
# ============================================================

# Sans Node, le hook laisse passer (la CI rejoue tout).
if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  [pre-commit] Node.js introuvable — check anti-fuite pro skippé."
  echo "    Installer Node depuis https://nodejs.org pour activer le hook."
  exit 0
fi

# Aucun fichier ni module du depot prive MyKTAMap-pro.
node scripts/check-no-pro-leak.js || exit $?

# Depot public : aucun nom reel lie aux releves (empreintes sha256, sans derogation).
node scripts/check-noms-reels.js || exit $?

# Cycle de vie des modales (consultatif).
node scripts/check-modal-lifecycle.js

# Chaque methode exportee par un module IIFE existe au chargement (node -c ne resout pas les identifiants).
node scripts/check-api-surface.js || exit $?

# Une pref globale sauvegardee est bien relue quand APP_CONFIG est reconstruit au chargement d'un plan.
node scripts/check-prefs-survival.js || exit $?

# Styles des types : une seule table canonique, resolue par ktaResolveStyle.
node scripts/check-style-canon.js || exit $?
node scripts/check-style-resolver.js || exit $?

# Styles KML figes (largeurs/alphas propres au KMZ) et un <Style> pour chaque type custom.
node scripts/check-kml-styles.js || exit $?

# Round-trip de la legende : type custom -> calque -> plan regenere, re-import idempotent.
node scripts/check-legend-roundtrip.js || exit $?

# Estimation du point B de georef (A + echelle + Nord), sur le code reel de config.js.
node scripts/check-georef-estimation.js || exit $?

# Dimensions d'image lues dans l'en-tete, sans decoder (cote > 32767 px refuse par Chrome).
node scripts/check-image-header-dims.js || exit $?

# Convertisseur de resolution de l'editeur de donnees : aucun champ de coordonnee oublie.
node scripts/check-resolution-convert.js || exit $?

# Mode Developpeur : pas de bibliotheque de docs, hash SHA-256, outils rendus en mode actif seulement.
node scripts/check-devmode-docs.js || exit $?

# Livrables : de docs/, seul docs/applications/ part, jamais le README.md racine.
node scripts/check-livrables-docs.js || exit $?

# lib/ : en-tete du fichier embarque = lib/package.json = lib/VERSIONS.md.
node scripts/check-libs.js || exit $?

# Textes des PDF : accents gardes, aucun caractere hors police, texte libre filtre par ktaTextePdf.
node scripts/check-pdf-texte.js || exit $?

# Popups natives : cliquet a 0 (ktaAlerte / ktaConfirm / toast).
node scripts/check-popups-natives.js || exit $?

# Couleurs en dur dans un style pose par le JS : cliquet (la charte s'ecrit var(--kta-...)).
node scripts/check-couleurs-inline.js || exit $?

# Forme du backlog : horizons, plafond de Maintenant, metadonnees des entrees (avertissement, jamais bloquant).
node scripts/check-backlog.js

# Commentaires = etat actuel : ni tag de version en tete, ni « ligne N », ni garde-fou absent ; cliquet.
node scripts/check-commentaires.js || exit $?

# Superoverlay KMZ : pavage exact des tuiles V2, coherence inter-niveaux, Lod/drawOrder.
node scripts/check-kmz-superoverlay.js || exit $?

# Aide integree : sections FR/EN appariees par index, couverture complete, sans doublon.
node scripts/check-aide-sections.js || exit $?

# PDF du Mode Histoire dans l'export de profil : opt-in strict, reimport idempotent.
node scripts/check-profile-histpdf.js || exit $?

# Catalogue des tags built-in : une seule source (map.js > TAGS_BUILTIN), parite des 9 tables.
node scripts/check-icon-catalog.js || exit $?

# Lambert 93 de l'import SIG, verifie par ses proprietes definitoires (aucune table recopiee).
node scripts/check-lambert93.js || exit $?

# GeoTIFF : repere, tiepoint, 3857, LZW et refus nommes, sur fixtures construites octet par octet.
node scripts/check-geotiff.js || exit $?

# Exports SIG : TIFF tuile relu a l'identique par notre lecteur, GeoKeys, calage a < 1 m, GeoJSON (filtres du KMZ).
node scripts/check-export-sig.js || exit $?

# Etiquettes a la generation : le fichier propose, l'utilisateur dispose ; 4 ecrivains de plan-config.
node scripts/check-plan-tags.js || exit $?

# Dossiers de « Mes plans » : registre execute, aucun plan perdu, regles par etiquette.
node scripts/check-plan-folders.js || exit $?

# Podometre global : le reglage global prime sur les cles d'un plan-config.
node scripts/check-podometre-global.js || exit $?

# Notifications : un seul goulot (OOMGuard.showToast), l'important et les erreurs survivent au silence.
node scripts/check-notifs.js || exit $?

# Constantes MAJUSCULES utilisees mais jamais declarees (node -c ne les voit pas).
node scripts/check-constantes-orphelines.js || exit $?

# Garde anti-doublon d'un listener portee par la map (window.map est remplacee a chaque plan).
node scripts/check-map-listeners.js || exit $?

# Reglages de podometre recopies en dur qui divergent de config.js > DEFAULT_CONFIG.
node scripts/check-tracking-defaults.js || exit $?

# Timeline du suivi : src, tp, estM, estSrc survivent au rechargement (sinon recalages et distance sous-comptes).
node scripts/check-timeline-restore.js || exit $?

# Valeurs hors bornes d'un plan-config (echelle, dimensions, depart) ramenees a l'usine.
node scripts/check-plan-config-borne.js || exit $?

# Pile OSM du HOME : etiquettes insensibles a la casse, clic asymetrique (ajouter / retirer).
node scripts/check-osm-etiquettes.js || exit $?

# Calque de donnees rapatrie dans la session : jamais de verrou sans sa copie, copie defensive.
node scripts/check-calque-session.js || exit $?

# Mettre a jour le plan : groupes, fichiers de calque, retrait de session sans trace destructrice, cablage.
node scripts/check-maj-plan.js || exit $?

# Outils mesure / coordonnees de la Vue OSM : memes dans les deux vues, exclusifs, demontes a la fermeture.
node scripts/check-osm-outils.js || exit $?

# Repositionner un POI : conversion inverse, index frais, mutation en place, liaisons recalees.
node scripts/check-repositionner.js || exit $?

# 🔒 XSS : fiche de point sans gestionnaire inline, filtres d'entree executes contre des charges d'attaque.
node scripts/check-xss.js || exit $?

# Echappement HTML unique (window.ktaEsc), aucune copie locale. Lit tout js/.
node scripts/check-esc.js || exit $?

# Relais Secours : l'intervention en cours n'est jamais ecrasee par le scenario d'un autre appareil.
node scripts/check-secours-relais.js || exit $?

# Tableau des groupes de la barre laterale (3 langues) confronte a interface.js.
node scripts/check-doc-sidebar.js || exit $?

# Selection multiple et conversion en lot : compatibilite par ouverture, un seul geste annulable.
node scripts/check-selection-multi.js || exit $?

# Reprise d'une sortie interrompue (closedBy: crash) et fusion manuelle ; WakeLock.init() au boot.
node scripts/check-journal-reprise.js || exit $?

# Ecran allume : verrou fantome iOS repris au premier geste ; vibration OFF par defaut.
node scripts/check-wakelock.js || exit $?

# Tuilage : un plan V2 passe toujours par les tuiles ; auto tranche sur la surface ; V2 servi en HTTP.
node scripts/check-tiling.js || exit $?

# Hors-ligne d'un plan serveur : cache dedie, etat lu du cache reel (jamais d'un drapeau).
node scripts/check-plan-offline.js || exit $?

# i18n : parite fr/en/es, cles appelees presentes, aucun HTML dans une cle rendue en textContent.
node scripts/check-i18n.js || exit $?

# Portee des reglages : est global ce qui persiste dans app_user_prefs ; rapatries atteignables au HOME.
node scripts/check-portee-reglages.js || exit $?

# Tags proposes par l'index : l'index propose, l'utilisateur dispose (jamais d'ecrasement au boot).
node scripts/check-tags-index.js || exit $?

# Kiosque serveur : interdits appliques au goulot (import de profil compris), aucun flag qui cache son remede.
node scripts/check-kiosque-serveur.js || exit $?

# Connexion serveur : meme validation app / ConfAdmin, index injoignable = DOWN (pas OFF), aucune requete.
node scripts/check-connexion-serveur.js || exit $?

# Export anonymise : aucun texte identifiant dans le JSON produit (session piegee a marqueurs).
node scripts/check-export-anonyme.js || exit $?

# Identifiants stables (uid + updatedAt) : ktaUid.js execute, cablage des sites, aucun uid vers KMZ/GPX.
node scripts/check-uid.js || exit $?

# Points d'extension : permission en echec = refus, gate deleguee en echec jamais rabattue sur la community.
node scripts/check-extensions.js || exit $?

# 🔒 Licences signees ECDSA P-256 : seule la cle PUBLIQUE est embarquee ; verification executee.
node scripts/check-licence.js || exit $?

# OSM actif par defaut : refus explicite ("0") jamais reecrase, les deux lecteurs d'accord.
node scripts/check-osm-defaut.js || exit $?

# 🔒 Mot de passe d'instance : barriere sociale (hash public), sans faille null == null ni comparaison laxiste.
node scripts/check-gate-instance.js || exit $?

# Outils de dessin resynchronises apres Ctrl+Z (HistoryManager.onChange).
node scripts/check-outils-dessin-sync.js || exit $?

# Position confirmee : urgence / « Y aller » partent de la position sans question si elle est sure.
node scripts/check-position-confirmee.js || exit $?

# Filets de donnees : snapshot avant import, confirmations chiffrees, verrou PIN temporise (decision produit).
node scripts/check-filets-donnees.js || exit $?

# Etat visible : pastille de filtres, toasts de restauration, etapes d'itineraire redessinees.
node scripts/check-etat-visible.js || exit $?

# Audit reseau : les deux domaines officiels ecrits en dur, jamais derives de location.origin.
node scripts/check-audit-domaine.js || exit $?

# Pile de plans du widget OSM : le plan quitte remplace l'ancien principal, groupes morts retires.
node scripts/check-osm-pile.js || exit $?

# Recherche plein texte de la Documentation : normalisation 1:1, occurrences non chevauchantes.
node scripts/check-doc-recherche.js || exit $?

# Reglages a enregistrement immediat (pas de bouton Appliquer), bornes executees.
node scripts/check-reglages-immediats.js || exit $?

# Ouverture manuelle d'une sortie : la sortie en cours n'est jamais ecrasee, refus toujours dit.
node scripts/check-journal-demarrage.js || exit $?

# Vocabulaire de la doc (« flyout », nombre de styles de legende) confronte au code.
node scripts/check-doc-vocabulaire.js || exit $?

# Aide contextuelle : table modale -> section confrontee au code dans les deux sens.
node scripts/check-aide-contextuelle.js || exit $?

# Integrite d'index.html : balises equilibrees, aucun id en double, aucun bloc recopie.
node scripts/check-html-integrite.js || exit $?

# Import multiple : N archives ajoutees sans qu'aucune ne s'ouvre, entree retiree si le stockage rate.
node scripts/check-import-masse.js || exit $?

# HOME PC : orphelin pleine largeur, primaire epingle, aucune largeur en px sur la colonne Actions.
node scripts/check-home-layout.js || exit $?

# Guidage de l'itineraire sur reseaux fictifs (quand annoncer, raccords a vol d'oiseau).
node scripts/check-guidage.js || exit $?

# Secours : secteurs et parcours de balayage executes sur le vrai graphe (reseau fictif).
node scripts/check-secours-balayage.js || exit $?

# 🔒 POI entre niveaux (jes / jpe / jps) : jamais une sortie de surface ; jonctions dans le graphe.
node scripts/check-poi-jonction.js || exit $?

# Parite des 3 guides utilisateur (memes sections, aucune traduction sous 70 % du FR).
node scripts/check-doc-langues.js || exit $?

# En-tete de licence sur tout script servi (js/*.js + sw.js).
node scripts/check-entete-licence.js || exit $?
# 🔒 CSP stricte : aucun script inline (onclick=, javascript:, <script> sans src), killsw.html excepte.
node scripts/check-csp-inline.js || exit $?

# Sessions en IndexedDB : aucun acces direct a localStorage["myktamap_session_v1_<planId>"].
node scripts/check-session-store.js || exit $?

# 🔒 Pages d'audit reseau generees depuis leurs .md (jamais retouchees a la main), assets precaches.
node scripts/check-audit-html.js || exit $?

# Photos : reimport ZIP sans effacer les photos du plan, limite de 5 par point.
node scripts/check-photos.js || exit $?
